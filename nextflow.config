manifest {
    name            = 'quick_synteny'
    description     = 'Taxonomy-guided synteny plotting: auto-discovers a reference genome and proteome from NCBI and aligns a target assembly against them.'
    author          = 'Guilherme Dias'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    help                  = false

    // required inputs
    taxid                 = null
    assembly              = null

    // manual overrides (skip NCBI discovery entirely when both are set)
    reference             = null
    proteome              = null

    // discovery behavior
    max_rank              = 'order'   // one of: species,genus,family,order,class,phylum
    min_seq_size          = 500000    // bp; sequences shorter than this are dropped from the synteny plot
    exclude_target         = false    // if true, never pick a same-species reference genome/proteome
                                       // source even at chromosome level -- see bin/find_closest_assembly.py
    min_asm_gap           = 100       // bp; minimum run of N's counted as an assembly gap -- see
                                       // bin/rename_sequences.py and the plot's "Show gaps" switch

    // synteny-chaining behavior -- see bin/chain.js's header
    min_identity          = null      // per-hit identity (0-1) below which a hit is ignored;
                                       // null auto-tunes from the observed data
    max_gap               = 25        // max genes skipped between consecutive block members
    min_block             = null      // min genes per block in links.tsv; null auto-tunes (15/5)

    // resource tuning (optional)
    miniprot_m            = null      // miniprot k-mer sampling exponent: samples 1/2^M of genomic
                                       // k-mers when indexing. Higher = less RAM, less sensitivity.
                                       // null keeps miniprot's own default. See modules/local/
                                       // miniprot_align.nf.
    miniprot_chunk_gb     = null      // align the proteome against ~this many Gb of genome at a
                                       // time, in parallel, instead of one whole-genome index --
                                       // caps peak RAM without changing results. null runs the
                                       // single whole-genome alignment (unchanged default path).
                                       // See modules/local/miniprot_align.nf (SPLIT_GENOME /
                                       // MINIPROT_ALIGN_CHUNK / MERGE_MINIPROT_GFF).
    miniprot_gb_per_gb    = 11        // RAM (GB) per Gb of CHUNK, plus a fixed 4 GB overhead, for
                                       // MINIPROT_ALIGN_CHUNK's dynamic memory directive. Only
                                       // used when miniprot_chunk_gb is set.

    // output
    outdir                = 'results'

    // execution
    slurm_queue           = 'normal'
    singularity_cache_dir = null
}

profiles {
    standard {
        docker.enabled    = true
        docker.runOptions = '--platform=linux/amd64'
        process.executor  = 'local'

        process {
            withLabel: 'process_low' {
                cpus   = 1
                memory = '2.GB'
            }
            withLabel: 'process_medium' {
                cpus   = 2
                memory = '4.GB'
            }
            withLabel: 'process_high' {
                cpus   = 4
                memory = '8.GB'
            }
        }
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}

dag {
    enabled   = false
}
