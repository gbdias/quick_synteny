{
  "name": "quick-synteny-gui",
  "version": "0.0.1",
  "private": true,
  "productName": "quick_synteny",
  "desktopName": "quick_synteny.desktop",
  "description": "A desktop app for the quick_synteny Nextflow pipeline (prototype)",
  "author": "Guilherme Dias",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:mac-arm64": "node scripts/fetch-micromamba.js darwin-arm64 && electron-builder --mac dmg --arm64 --publish never",
    "dist:mac-x64": "node scripts/fetch-micromamba.js darwin-x64 && electron-builder --mac dmg --x64 --publish never",
    "dist:linux-x64": "node scripts/fetch-micromamba.js linux-x64 && electron-builder --linux AppImage --x64 --publish never",
    "dist:linux-arm64": "node scripts/fetch-micromamba.js linux-arm64 && electron-builder --linux AppImage --arm64 --publish never",
    "icons": "electron scripts/make-icns.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "se.nbis.quick-synteny",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../main.nf",
        "to": "pipeline/main.nf"
      },
      {
        "from": "../nextflow.config",
        "to": "pipeline/nextflow.config"
      },
      {
        "from": "../nextflow_schema.json",
        "to": "pipeline/nextflow_schema.json"
      },
      {
        "from": "../bin",
        "to": "pipeline/bin",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../modules",
        "to": "pipeline/modules"
      },
      {
        "from": "../conf",
        "to": "pipeline/conf"
      },
      {
        "from": "../envs",
        "to": "pipeline/envs"
      },
      {
        "from": "runtime.yml",
        "to": "runtime.yml"
      },
      {
        "from": "vendor/micromamba/${platform}-${arch}/micromamba",
        "to": "micromamba/micromamba"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "Science",
      "syncDesktopName": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
