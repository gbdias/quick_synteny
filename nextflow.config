manifest {
    name            = 'quick_synteny'
    description     = 'Taxonomy-guided synteny plotting: auto-discovers a reference genome and proteome from NCBI and aligns a target assembly against them.'
    author          = 'Guilherme Dias'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'    // nf-schema 2.7's minimum
    version         = '0.1.0'
}

// nf-schema validates params against nextflow_schema.json and builds
// --help from it. Pinned so a run works offline once installed; 2.7.3 is
// the last release for Nextflow 25.10 (2.8 and 3.x need 26.04).
plugins {
    id 'nf-schema@2.7.3'
}

validation {
    // a misspelled parameter (--max-rank) is an error, not silently ignored
    logging {
        unrecognisedParams = 'error'
    }
    help {
        enabled    = true
        command    = 'nextflow run main.nf --taxid <TAXID> --assembly <target.fa> [options]'
        beforeText = '\nquick_synteny -- taxonomy-guided synteny plotting\n'
        afterText  = '''
Profiles:
  -profile standard   Docker + local executor (default for a laptop/CI)
  -profile conda      Conda envs from envs/*.yml + local executor (no Docker)
  -profile slurm      Apptainer + SLURM executor (HPC)
  -profile test       Docker + local executor with tiny resource caps
'''
    }
}

params {
    help                  = false

    // required inputs
    taxid                 = null
    assembly              = null

    // manual overrides (both set: no NCBI discovery)
    reference             = null
    proteome              = null

    // a chosen NCBI reference (at most one of these and --reference)
    reference_taxid       = null      // the best chromosome-level assembly of this taxon
    reference_accession   = null      // exactly this assembly (GCA_/GCF_...)

    // discovery behavior
    max_rank              = 'order'   // one of: species,genus,family,order,class,phylum
    min_seq_size          = 10000     // bp; sequences shorter than this are dropped from the synteny plot
    exclude_target         = false    // never pick a same-species reference genome/proteome
    min_asm_gap           = 100       // bp; minimum run of N's counted as an assembly gap

    // synteny chaining (bin/chain.js). Hidden from --help and the desktop
    // app: the page re-chains with any values, so these only set its
    // starting controls and links.tsv
    min_identity          = null      // per-hit identity floor (0-1); null is chain.js's 0.7
    max_gap               = 25        // max anchors skipped between consecutive block members
    min_block             = null      // min anchors per block in links.tsv; null is chain.js's 15

    // resource tuning (optional)
    miniprot_m            = null      // miniprot -M (index 1/2^M of k-mers); null is miniprot's default
    miniprot_chunk_gb     = null      // align ~this many Gb of genome at a time to cap peak RAM;
                                       // bare flag = 1 Gb; null = one whole-genome alignment
    miniprot_gb_per_gb    = 11        // MINIPROT_ALIGN_CHUNK's RAM (GB) per Gb of chunk, plus 4 GB

    // output
    outdir                = 'results'

    // execution
    slurm_queue           = 'normal'
    singularity_cache_dir = null
}

process {
    // one thread in every profile: the index build's peak RAM grows with its
    // thread count (see miniprot_align.nf). withName outranks the profiles'
    // withLabel, so process_high still sets memory/time.
    withName: 'MINIPROT_INDEX' {
        cpus = 1
    }
    // datasets (Go) only looks for CA certificates under /etc/ssl, which the
    // Seqera image lacks; without this every NCBI request fails with
    // "x509: certificate signed by unknown authority"
    withLabel: 'env_ncbi_datasets' {
        containerOptions = { workflow.containerEngine == 'docker'
            ? '-e SSL_CERT_FILE=/opt/conda/ssl/cacert.pem'
            : '--env SSL_CERT_FILE=/opt/conda/ssl/cacert.pem' }
    }
}

// every process's image, per container engine and host architecture --
// generated from envs/*.yml by tools/update_containers.py
includeConfig 'conf/containers.config'

profiles {
    standard {
        docker.enabled    = true
        process.executor  = 'local'
        // no --platform: conf/containers.config picks each image for the
        // host's architecture

        process {
            withLabel: 'process_low' {
                cpus   = 1
                memory = '2.GB'
            }
            withLabel: 'process_high' {
                cpus   = 4
                memory = '8.GB'
            }
        }
    }

    conda {
        includeConfig 'conf/conda.config'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
