# Paths to the Apptainer images for each tool
MPROT="/proj/snic2021-6-194/private/guilherme/singularity/miniprot_0.18--f3885d2907a66c41.sif"
JCVI="/proj/snic2021-6-194/private/guilherme/singularity/jcvi_1.5.7--37261bbd6bc87a20.sif"
AGAT="/proj/snic2021-6-194/private/guilherme/singularity/agat_1.5.1--63745027011a3fdd.sif"
FASIZE="/proj/snic2021-6-194/private/guilherme/singularity/ucsc-fasize_482--010b2d8c8e567db7.sif"

BASE="" # base directory for the Apptainer mount
OUTDIR=""   # the output directory

# data inputs
PROT=""     # path to a suitable proteome
TARGET=""   # path to the fasta file of the target genome
TARGETNAME=""   # name for the target genome, no spaces or special characters
REF=""      # path to the reference genome. This is usually a chromosome-level assembly from NCBI.
REFNAME=""  # name for the reference genome, no spaces or special characters

# settings
GENES=50    # the minimum gene number a contig must have for it to be drawn
THREADS=10  # number of threads for miniprot