process {
    executor       = 'slurm'
    queue          = params.slurm_queue ?: 'normal'
    errorStrategy  = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries     = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '30.m'
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '16.GB'
        time   = '2.h'
    }
    withLabel: 'process_high' {
        cpus   = 24
        memory = '32.GB'
        time   = '4.h'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = params.singularity_cache_dir ?: "${baseDir}/.singularity"
}
