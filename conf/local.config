// The local profiles (standard, conda, test): no task may ask for more
// cores or memory than this machine has. The local executor refuses such a
// task outright ("Task requirement exceeds available memory"), so a
// request sized from a big genome, or grown by a retry, is cut down to the
// machine instead, and runs if it fits.
//
// Bytes, from the JVM's view of the OS -- the same total Nextflow's local
// executor checks against. Under Docker Desktop (macOS) the containers' VM
// can have less than this; its own limit still applies.
process.resourceLimits = [
    cpus: Runtime.runtime.availableProcessors(),
    memory: "${java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize()} B"
]
