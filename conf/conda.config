// No container engine: each env_<name> label gets envs/<name>.yml as a
// conda environment. Same pinned versions as the images, but solved on this
// host, so dependencies can differ -- see README, "Profiles".
//
// A new envs/<name>.yml needs its line here too.

conda.enabled     = true
process.executor  = 'local'

process {
    withLabel: 'env_bokeh'         { conda = "${projectDir}/envs/bokeh.yml" }
    withLabel: 'env_miniprot'      { conda = "${projectDir}/envs/miniprot.yml" }
    withLabel: 'env_ncbi_datasets' { conda = "${projectDir}/envs/ncbi_datasets.yml" }
    withLabel: 'env_nodejs'        { conda = "${projectDir}/envs/nodejs.yml" }
    withLabel: 'env_python'        { conda = "${projectDir}/envs/python.yml" }

    // same as the standard profile
    withLabel: 'process_low' {
        cpus   = 1
        memory = '2.GB'
    }
    withLabel: 'process_high' {
        cpus   = 4
        memory = '8.GB'
    }
}
