process {
    executor       = 'slurm'
    queue          = params.slurm_queue ?: 'normal'
    errorStrategy  = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries     = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '30.m'
    }
    // big genomes (e.g. axolotl, ~30 Gb) plus in-script rehydrate retries
    // outlast process_low's 30 min
    withName: 'DOWNLOAD_.*' {
        time   = '4.h'
    }
    // unlabeled (a label's memory would override its per-chunk memory), so
    // it needs its own time cap
    withName: 'MINIPROT_ALIGN_CHUNK' {
        time   = '12.h'
    }
    withLabel: 'process_high' {
        cpus   = 24
        memory = '32.GB'
        time   = '4.h'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = params.singularity_cache_dir ?: "${projectDir}/.singularity"
}
