// No container engine: each env_<name> label gets envs/<name>.yml as a
// conda environment. Same pinned versions as the images, but solved on this
// host, so dependencies can differ -- see README, "Profiles".
//
// A new envs/<name>.yml needs its line here too.

conda.enabled     = true
process.executor  = 'local'

// conda, mamba or micromamba, whichever comes first on the PATH (searched
// in order, conda before mamba before micromamba within one directory),
// so a machine with only one of them works. With none, Nextflow's default
// (conda) fails at the first environment. The desktop app puts its own
// micromamba first on the PATH and sets useMicromamba itself, which this
// agrees with. Written twice because strict config syntax can't hold the
// lookup in a variable.
conda.useMamba = (System.getenv('PATH') ?: '').tokenize(java.io.File.pathSeparator).findResult { dir ->
    ['conda', 'mamba', 'micromamba'].find { tool -> new java.io.File(dir, tool).canExecute() } } == 'mamba'
conda.useMicromamba = (System.getenv('PATH') ?: '').tokenize(java.io.File.pathSeparator).findResult { dir ->
    ['conda', 'mamba', 'micromamba'].find { tool -> new java.io.File(dir, tool).canExecute() } } == 'micromamba'

process {
    withLabel: 'env_bokeh'         { conda = "${projectDir}/envs/bokeh.yml" }
    withLabel: 'env_miniprot'      { conda = "${projectDir}/envs/miniprot.yml" }
    withLabel: 'env_ncbi_datasets' { conda = "${projectDir}/envs/ncbi_datasets.yml" }
    withLabel: 'env_nodejs'        { conda = "${projectDir}/envs/nodejs.yml" }
    withLabel: 'env_python'        { conda = "${projectDir}/envs/python.yml" }

    // same as the standard profile
    withLabel: 'process_low' {
        cpus   = 1
        memory = '2.GB'
    }
    // no memory: the miniprot processes size it from the genome
    withLabel: 'process_high' {
        cpus   = 4
    }
}
