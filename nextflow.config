manifest {
    name            = 'quick_synteny'
    description     = 'Taxonomy-guided synteny plotting: auto-discovers a comparison genome and proteome from NCBI and aligns a target assembly against them.'
    author          = 'Guilherme Dias'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    help                  = false

    // required inputs
    taxid                 = null
    assembly              = null

    // manual overrides (skip NCBI discovery entirely when both are set)
    comparison            = null
    proteome              = null

    // discovery behavior
    max_rank              = 'order'   // one of: species,genus,family,order,class,phylum
    min_seq_size          = 0         // bp; sequences shorter than this are dropped from the synteny plot

    // synteny-chaining behavior
    min_identity          = null      // per-hit identity (0-1) below which an anchor is dropped;
                                       // default (null) auto-tunes from the observed data instead
                                       // of a fixed cutoff -- see build_synteny_blocks.py

    // polyploid support (optional)
    show_homeologs        = 'both'    // '', 'target', 'comparison', or 'both' -- also find/draw
                                       // that genome's own homeologous chromosome pairs

    // output
    outdir                = 'results'

    // execution
    slurm_queue           = 'normal'
    singularity_cache_dir = null
}

profiles {
    standard {
        docker.enabled    = true
        docker.runOptions = '--platform=linux/amd64'
        process.executor  = 'local'

        process {
            withLabel: 'process_low' {
                cpus   = 1
                memory = '2.GB'
            }
            withLabel: 'process_medium' {
                cpus   = 2
                memory = '4.GB'
            }
            withLabel: 'process_high' {
                cpus   = 4
                memory = '8.GB'
            }
        }
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}

dag {
    enabled   = false
}
